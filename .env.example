# Environment variables template
# Copy this to .env and fill in your values

# Google OAuth (client ID is public, safe to commit)
GOOGLE_OAUTH_CLIENT_ID=767682935121-t52475j0g6aui95lgo1fkik5vqdodnp9.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-secret-here

# Database
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret
# JWT_SECRET=your-jwt-secret-here

# Admin emails (comma-separated)
# ADMIN_EMAILS=josh@pellsolar.com

# SendGrid
# SENDGRID_API_KEY=your-sendgrid-key
# OWNER_NOTIFY_EMAIL=josh@pellsolar.com
# NOTIFY_FROM_EMAIL=info@pellsolar.com

# Twilio
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_NOTIFY_NUMBER=+1234567890

# Cloudflare R2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-key-id
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=pellsolar-website
# R2_PUBLIC_BASE_URL=https://your-bucket-url

# Google Maps
# GOOGLE_MAPS_API_KEY=your-maps-key

# Anthropic AI
# ANTHROPIC_API_KEY=your-anthropic-key

# CRM Integration
# WEBSITE_LEAD_SECRET=your-lead-secret
# CRM_CUSTOMER_CHECK_URL=https://pellsolar-crm-prod.onrender.com/api/check-customer

# Cloudflare Turnstile (optional)
# TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key
